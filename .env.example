# Pharma Sales & COGS platform: local configuration.
# Copy this file to `.env` and adjust as needed. NEVER commit `.env` (see .gitignore).
# docker-compose.yml, loader/db.py and dbt/profiles.yml all read these variables.

# docker-compose.yml has no defaults for these three: without a .env the
# Postgres container will not start.
POSTGRES_DB=pharma_db
POSTGRES_USER=pharma_user
POSTGRES_PASSWORD=change_me

# Host and port the Python modules and dbt connect on.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Where the generator writes CSVs and the exporter writes Parquet.
DATA_DIR=./data

# Optional: cron_runner.sh emails this address when a pipeline step fails.
# NOTIFY_EMAIL=you@example.com
